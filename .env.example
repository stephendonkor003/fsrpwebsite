APP_NAME="Africa Programme Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

SEO_CANONICAL_URL=https://fsrp.africa
SEO_INDEXING_ENABLED=true
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_TABLE=browser_sessions
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=graph
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CERT_PATH=/etc/au-entra/certs/shared/au-graph-cert.pem
MICROSOFT_PRIVATE_KEY_PATH=/etc/au-entra/certs/shared/au-graph-private.pem
MICROSOFT_MAIL_FROM=Noreply-AUCATTP@africanunion.org
MICROSOFT_MAIL_FROM_NAME="SEED SUBMIT"
MICROSOFT_GRAPH_CONNECT_TIMEOUT=10
MICROSOFT_GRAPH_TIMEOUT=30
MICROSOFT_GRAPH_CERTIFICATE_EXPIRY_WARNING_DAYS=30

SEED_SUMMIT_UNVERIFIED_RETENTION_DAYS=30
SEED_SUMMIT_RETENTION_DAYS_AFTER_EVENT=365

ADMIN_NAME="Site Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
